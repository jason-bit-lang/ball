# Environnements virtuels Python (chacun recree le sien avec requirements.txt)
venv/
env/
.venv/

# Fichiers compiles par Python
__pycache__/
*.pyc

# Secrets : la cle OpenAI et les mots de passe restent sur la machine
.env
.env.*
!.env.example

# Base de donnees locale (recreee au demarrage par run.py)
database/*
!database/.gitkeep
*.db

# Ancien dossier des CV (avant la partie 5, les CV sont maintenant dans la base) : donnees personnelles
uploads/

# Fichiers audio temporaires du pitch (supprimes apres l'envoi)
api_service/temp_audio/*
!api_service/temp_audio/.gitkeep

# Journal du site (contient des adresses IP et des emails)
logs/

# Fichiers d'editeur et du systeme
.vscode/
.idea/
.DS_Store
Thumbs.db

# Extraits audio des mesures WER / CER / MOS (pipeline/metriques_audio.py)
data/audio/
