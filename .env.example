# Copier ce fichier en .env puis remplir les valeurs. Ne jamais pousser .env sur GitHub.
SECRET_KEY=remplacer_par_une_longue_chaine_aleatoire
OPENAI_API_KEY=remplacer_par_votre_cle
# Mettre 1 pour activer le mode debug en local uniquement
FLASK_DEBUG=0
# Sur Render seulement : adresse de la base Postgres (donnee par Render). En local, laisser vide : SQLite.
DATABASE_URL=
